--------------------------------------------------------------------------------
-- Smokes and Alcohol Psy Relief by Expand  v1.0.0  (for G.A.M.M.A.)
--
-- Smokes restore psy health instead of radiation; alcohol keeps its radiation
-- restore and also restores psy health. Being drunk boosts psy restore and
-- gives psy protection.
--
-- - Smokes lose boost_radiation_restore in mod_system_zzz_psy_relief.ltx (DLTX).
-- - [psy_relief_items] in the same file lists known items: kind (smoke /
--   alcohol / none), psy health per use at the Medium preset, optional time.
-- - Other items are detected from their final config (auto-detect option):
--   smoke = use_sound "inv_smoke" or required_tool box_matches, without an own
--   psy booster (joint/marijuana have one); alcohol = eat_alcohol > 0 and a
--   drink (kind i_drink or a drink use_sound), so meds with alcohol are skipped.
--   They get the amounts from [psy_relief_auto]. Their radiation restore (if
--   any) cannot be removed by script.
-- - On item use the amount (x the kind's MCM preset) is restored gradually over
--   the item's boost_time. Doses stack.
-- - Drunkenness = engine alcohol level 0..1 (conditions():GetAlcohol(), modded
--   exes). While drunk: every psy gain is raised by restore_bonus x alcohol and
--   every psy loss is partly given back (protection x alcohol); both from MCM
--   sliders (their presets live in psy_relief_mcm.script), own on/off switch. Works on the
--   measured psy health, so it covers every psy source (hits, fields, stress)
--   without patching the damage balancer or the psy scripts.
-- - A tick (TICK_MS) runs only while a dose is active or the actor is drunk
--   (actor_on_update registered on demand); otherwise no per-frame work.
-- - Psy health goes through arszi_psy.get/change_psy_health (G.A.M.M.A. Psy
--   rework or Psy Stress Remake; writing the engine value directly would be
--   undone by them). Without arszi_psy: the engine's psy health.
-- - Tooltip: a row in the consumable stats block (utils_ui.stats_table.booster,
--   re-added from the wrapped ui_item.item_description / get_sec_desc because
--   GAMMA's ish_item_stats replaces that table); a description line when the
--   UI has no stats table. Wrappers are chain-safe.
--
-- Log tag: [PsyRelief]
--------------------------------------------------------------------------------

local MCM_ID = "psy_relief"
local ITEMS_SECTION = "psy_relief_items"
local AUTO_SECTION = "psy_relief_auto"

-- defaults (used without MCM)
local defaults = {
	enabled          = true,
	smoke_preset     = "medium",
	alcohol_preset   = "medium",
	auto_detect      = true,
	drunk_enabled    = true,
	drunk_restore    = 100,   -- % extra psy restore at full drunkenness (slider, moved by its MCM preset)
	drunk_protection = 50,    -- % of psy loss given back at full drunkenness (slider, moved by its MCM preset)
	tooltip          = true,
	debug            = false,
}

-- strength presets: multiplier of the per-item amounts
local PRESETS = {
	light  = 0.6,
	mild   = 0.8,
	medium = 1.0,
	potent = 1.3,
	strong = 1.6,
}

local TICK_MS = 500          -- restore / drunk check interval while active
local DEFAULT_TIME = 30      -- seconds, when an item has no boost_time
local MIN_TIME = 1           -- seconds
local MAX_DOSES = 16         -- more doses at once are merged into the last one
local DRUNK_MIN = 0.005      -- alcohol level below this counts as sober
local MAX_PROTECTION = 0.9
local AUTO_SMOKE = 0.05      -- fallbacks when [psy_relief_auto] is missing
local AUTO_ALCOHOL = 0.07
local DATA_VERSION = 1

local floor, min, max = math.floor, math.min, math.max
local tostring, tonumber, type = tostring, tonumber, type
local sformat, smatch, sfind, slower = string.format, string.match, string.find, string.lower

-- settings
local enabled = defaults.enabled
local mul = { smoke = PRESETS.medium, alcohol = PRESETS.medium }
local auto_detect = defaults.auto_detect
local drunk_enabled = defaults.drunk_enabled
local drunk_restore = defaults.drunk_restore / 100
local drunk_protection = defaults.drunk_protection / 100
local tooltip = defaults.tooltip
local debug = defaults.debug

-- state
local listed = {}            -- section -> { kind, amount, time } or false (kind "none"), from the ltx list
local auto_cache = {}        -- section -> { kind, amount, time } or false, detected on first use
local alcohol_cache = {}     -- section -> eat_alcohol
local auto_amount = { smoke = AUTO_SMOKE, alcohol = AUTO_ALCOHOL }
local doses = {}             -- array of { left = psy amount still to restore, ms = time left }
local ticking = false
local next_tick = 0
local last_tick = 0
local last_psy = nil         -- psy health after our last tick (to measure gains/losses)
local psy_mod = nil          -- arszi_psy when it has get/change_psy_health
local has_alcohol_api = false
local patched = false
local orig_item_desc, orig_sec_desc

local function log(fmt, ...)
	printf("[PsyRelief] %s", sformat(fmt, ...))
end

local function dbg(fmt, ...)
	if debug then
		printf("[PsyRelief] %s", sformat(fmt, ...))
	end
end

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------
local function get_config(key)
	if ui_mcm then
		local v = ui_mcm.get(MCM_ID .. "/" .. key)
		if v ~= nil then return v end
	end
	return defaults[key]
end

local function preset_mul(key)
	local p = get_config(key)
	return PRESETS[p] or PRESETS[defaults[key]]
end

local function apply_options()
	enabled = get_config("enabled") and true or false
	mul.smoke = preset_mul("smoke_preset")
	mul.alcohol = preset_mul("alcohol_preset")
	local ad = get_config("auto_detect") and true or false
	if ad ~= auto_detect then
		auto_cache = {}
	end
	auto_detect = ad
	drunk_enabled = get_config("drunk_enabled") and true or false
	drunk_restore = max(0, tonumber(get_config("drunk_restore")) or defaults.drunk_restore) / 100
	drunk_protection = min(MAX_PROTECTION, max(0, (tonumber(get_config("drunk_protection")) or defaults.drunk_protection) / 100))
	tooltip = get_config("tooltip") and true or false
	debug = get_config("debug") and true or false
end

--------------------------------------------------------------------------------
-- Items
--------------------------------------------------------------------------------
local function item_time(sec, time)
	time = tonumber(time)
	if not time or time <= 0 then
		time = tonumber(SYS_GetParam(2, sec, "boost_time", 0)) or 0
	end
	if time <= 0 then time = DEFAULT_TIME end
	return max(time, MIN_TIME)
end

local function load_items()
	listed = {}
	auto_cache = {}
	alcohol_cache = {}
	local ini = system_ini()
	if not ini then return end

	if ini:section_exist(AUTO_SECTION) then
		auto_amount.smoke = tonumber(SYS_GetParam(2, AUTO_SECTION, "smoke", AUTO_SMOKE)) or AUTO_SMOKE
		auto_amount.alcohol = tonumber(SYS_GetParam(2, AUTO_SECTION, "alcohol", AUTO_ALCOHOL)) or AUTO_ALCOHOL
	end

	if not ini:section_exist(ITEMS_SECTION) then
		log("ERROR: section [%s] not found; only auto-detected items restore psy health", ITEMS_SECTION)
		return
	end
	local count = 0
	local n = ini:line_count(ITEMS_SECTION)
	for i = 0, n - 1 do
		local _, sec, val = ini:r_line(ITEMS_SECTION, i, "", "")
		local kind, amount, time
		if type(val) == "string" then
			kind = smatch(val, "^%s*(%a+)")
			amount, time = smatch(val, "^%s*%a+%s*,%s*([%d%.]+)%s*,?%s*([%d%.]*)")
		end
		amount = tonumber(amount)
		if sec and sec ~= "" and kind == "none" then
			listed[sec] = false
		elseif sec and sec ~= "" and (kind == "smoke" or kind == "alcohol") and amount and amount > 0 then
			if ini:section_exist(sec) then
				listed[sec] = { kind = kind, amount = min(amount, 1), time = item_time(sec, time) }
				count = count + 1
			end
		else
			log("ERROR: bad line in [%s]: %s = %s", ITEMS_SECTION, tostring(sec), tostring(val))
		end
	end
	log("%s listed items restore psy health", tostring(count))
end

-- smoke / alcohol from the item's final config, or nil
local function detect_kind(sec)
	if (tonumber(SYS_GetParam(2, sec, "boost_telepat_protection", 0)) or 0) > 0 then
		return nil  -- has its own psy booster (joint, marijuana, psy meds)
	end
	local snd = slower(SYS_GetParam(0, sec, "use_sound", "") or "")
	local tool = SYS_GetParam(0, sec, "required_tool", "") or ""
	if sfind(snd, "inv_smoke", 1, true) or tool == "box_matches" then
		return "smoke"
	end
	local alc = tonumber(SYS_GetParam(2, sec, "eat_alcohol", 0)) or 0
	if alc > 0 and (SYS_GetParam(0, sec, "kind", "") == "i_drink" or sfind(snd, "drink", 1, true)) then
		return "alcohol"
	end
	return nil
end

local function get_item(sec)
	if not sec then return nil end
	local it = listed[sec]
	if it ~= nil then return it or nil end
	if not auto_detect then return nil end
	it = auto_cache[sec]
	if it == nil then
		it = false
		local ini = system_ini()
		if ini and ini:section_exist(sec) then
			local kind = detect_kind(sec)
			if kind then
				it = { kind = kind, amount = auto_amount[kind], time = item_time(sec), auto = true }
			end
		end
		auto_cache[sec] = it
	end
	return it or nil
end

-- psy health one use of the item restores (preset applied, 0..1), nil if none
local function item_amount(sec)
	local it = get_item(sec)
	if not it then return nil end
	return it.amount * (mul[it.kind] or 1), it
end

local function item_alcohol(sec)
	local a = alcohol_cache[sec]
	if a == nil then
		a = tonumber(SYS_GetParam(2, sec, "eat_alcohol", 0)) or 0
		alcohol_cache[sec] = a
	end
	return a
end

--------------------------------------------------------------------------------
-- Psy health and drunkenness
--------------------------------------------------------------------------------
local function find_psy_module()
	local m = arszi_psy
	if type(m) == "table" and type(m.change_psy_health) == "function" and type(m.get_psy_health) == "function" then
		return m
	end
	return nil
end

-- psy health 0..1, nil when unknown (G.A.M.M.A. Psy rework before its data is loaded)
local function read_psy(actor)
	if psy_mod then
		local v = psy_mod.get_psy_health()
		return type(v) == "number" and v or nil
	end
	return actor.psy_health
end

local function apply_psy(delta, actor)
	if psy_mod then
		if type(psy_mod.get_psy_health()) == "number" then
			psy_mod.change_psy_health(delta)
		end
		return
	end
	actor:change_psy_health(delta)
end

-- alcohol level 0..1 (modded exes), 0 when not available
local function get_drunk(actor)
	if not has_alcohol_api then return 0 end
	local a = actor:cast_Actor()
	local cond = a and a:conditions()
	local v = cond and cond:GetAlcohol()
	return (type(v) == "number" and v > DRUNK_MIN) and v or 0
end

local function drunk_effects_on()
	return has_alcohol_api and drunk_enabled and (drunk_restore > 0 or drunk_protection > 0)
end

--------------------------------------------------------------------------------
-- Tick (only while a dose is active or the actor is drunk)
--------------------------------------------------------------------------------
local tick  -- forward

local function start_ticking()
	if ticking then return end
	ticking = true
	last_tick = time_global()
	next_tick = last_tick + TICK_MS
	last_psy = nil
	RegisterScriptCallback("actor_on_update", tick)
end

local function stop_ticking()
	if not ticking then return end
	ticking = false
	last_psy = nil
	UnregisterScriptCallback("actor_on_update", tick)
end

local function clear_doses()
	doses = {}
	stop_ticking()
end

tick = function()
	local now = time_global()
	if now < next_tick then return end
	next_tick = now + TICK_MS

	local actor = db.actor
	if not (enabled and actor and actor:alive()) then
		clear_doses()
		return
	end

	local dt = now - last_tick
	last_tick = now

	local drunk = drunk_effects_on() and get_drunk(actor) or 0
	local extra = 0

	-- drunk: raise psy gains, give back part of psy losses since the last tick
	local psy = read_psy(actor)
	if drunk > 0 and psy and last_psy then
		local d = psy - last_psy
		if d < 0 then
			extra = -d * min(MAX_PROTECTION, drunk_protection * drunk)
		elseif d > 0 then
			extra = d * drunk_restore * drunk
		end
	end

	-- doses
	local n = #doses
	if n > 0 and dt > 0 then
		local total = 0
		local j = 0
		for i = 1, n do
			local d = doses[i]
			local step = (dt >= d.ms) and d.left or (d.left * dt / d.ms)
			total = total + step
			d.left = d.left - step
			d.ms = d.ms - dt
			if d.ms > 0 and d.left > 1e-7 then
				j = j + 1
				doses[j] = d
			end
		end
		for i = j + 1, n do
			doses[i] = nil
		end
		extra = extra + total * (1 + drunk_restore * drunk)
		if j == 0 then dbg("all doses done") end
	end

	if extra > 0 and psy then
		apply_psy(extra, actor)
		psy = read_psy(actor)
	end
	last_psy = psy

	if #doses == 0 and drunk <= 0 then
		dbg("no dose active and sober: tick off")
		stop_ticking()
	end
end

local function add_dose(amount, seconds)
	local n = #doses
	if n >= MAX_DOSES then
		local d = doses[n]
		d.left = d.left + amount
		d.ms = max(d.ms, seconds * 1000)
	else
		doses[n + 1] = { left = amount, ms = seconds * 1000 }
	end
	start_ticking()
end

local function actor_on_item_use(obj, sec)
	if not enabled then return end
	if type(sec) ~= "string" then
		sec = obj and obj.section and obj:section()
	end
	if not sec then return end
	local actor = db.actor
	if not (actor and actor:alive()) then return end

	local amount, it = item_amount(sec)
	if amount and amount > 0 then
		add_dose(amount, it.time)
		dbg("%s used (%s%s): %.1f%% psy health over %.0f s, %d active doses", sec, it.kind,
			it.auto and ", auto-detected" or "", amount * 100, it.time, #doses)
	end
	-- anything with alcohol (also meds) starts the drunk effects
	if item_alcohol(sec) > 0 and drunk_effects_on() then
		start_ticking()
	end
end

--------------------------------------------------------------------------------
-- Tooltip
--------------------------------------------------------------------------------
local clr_bul, clr_txt, clr_val

local function init_colors()
	if clr_txt then return end
	local gcol = utils_xml and utils_xml.get_color
	clr_bul = gcol and gcol("d_green") or "%c[255,56,209,115]"
	clr_txt = gcol and gcol("ui_gray_2") or "%c[255,170,170,170]"
	clr_val = gcol and gcol("ui_gray_1") or "%c[255,230,230,230]"
end

local function fmt_pct(x)
	local s = sformat("%.1f", x * 100)
	return (s:gsub("%.0$", ""))
end

local function build_line(sec)
	if not (enabled and tooltip) then return nil end
	local amount, it = item_amount(sec)
	if not amount then return nil end
	init_colors()
	local gc = game.translate_string
	return clr_bul .. "  \149 " .. clr_txt .. " " .. gc("st_psy_relief_tt") .. ": " .. clr_val .. "+" .. fmt_pct(amount)
		.. "%" .. clr_txt .. " " .. sformat(gc("st_psy_relief_tt_time"), floor(it.time + 0.5)) .. " \\n"
end

-- Stats row: a row in the item info's consumable stats block (utils_ui.stats_table.booster, next to
-- "Effect time", "Satiety"...), drawn by utils_ui itself with its icon and columns. GAMMA's
-- ish_item_stats replaces the whole booster table on game start and on a difficulty change, so the row
-- is (re)added whenever a tooltip of one of our items is built (the description is read before the stats).
-- Without that table (other UI) the description line above is used instead.
local STAT_KEY = "psy_relief_restore"
local STAT_INDEX = 3.5       -- after health (2) and radiation (3) restore, before satiety (4)
local STAT_UNIT = "st_perc"
local stat_row = {
	index = STAT_INDEX, typ = "float", name = "st_psy_relief_stat",
	icon_p = "ui_am_propery_11", icon_n = "ui_am_propery_11",
	track = false, magnitude = 100, unit = STAT_UNIT,
	compare = false, sign = true, show_always = false,
	value_functor = { "psy_relief", "stat_value" },
}

-- true when our row is in the stats table (added now or already there)
local function ensure_stat_row()
	local uu = utils_ui
	local st = type(uu) == "table" and uu.stats_table
	local booster = type(st) == "table" and st.booster
	if type(booster) ~= "table" then return false end
	if booster[STAT_KEY] == nil then
		booster[STAT_KEY] = stat_row
	end
	return true
end

-- value_functor of the stats row (called by utils_ui.get_stats_value): psy health per use (0..1), 0 = no row.
-- The restore time normally equals the item's boost_time, shown in the "Effect time" row; when it differs
-- (time set in [psy_relief_items], or no boost_time) it is added after the value.
function stat_value(obj, sec)
	stat_row.unit = STAT_UNIT
	if not (enabled and tooltip) then return 0 end
	if not sec and obj then sec = obj:section() end
	local amount, it = item_amount(sec)
	if not amount then return 0 end
	local t = floor(it.time + 0.5)
	local bt = tonumber(SYS_GetParam(2, sec, "boost_time", 0)) or 0
	if t ~= floor(bt + 0.5) then
		local gc = game.translate_string
		stat_row.unit = gc(STAT_UNIT) .. " " .. sformat(gc("st_psy_relief_tt_time"), t)
	end
	return amount
end

local function desc_line(sec)
	if ensure_stat_row() then return nil end
	return build_line(sec)
end

local function psy_relief_item_description(obj, str, ...)
	local res = orig_item_desc(obj, str, ...)
	if not (enabled and tooltip) or type(obj) ~= "userdata" or type(res) ~= "string" then return res end
	local line = desc_line(obj:section())
	if line then
		return res .. line
	end
	return res
end

local function psy_relief_sec_desc(sec, ...)
	local res = orig_sec_desc(sec, ...)
	if not (enabled and tooltip) or type(res) ~= "string" then return res end
	local line = desc_line(sec)
	if line then
		return res .. line
	end
	return res
end

local function install_patches()
	if patched then return end
	patched = true
	local ui = ui_item
	if ui and type(ui.item_description) == "function" then
		orig_item_desc = ui.item_description
		ui.item_description = psy_relief_item_description
	else
		log("ERROR: ui_item.item_description not found; no tooltip line")
	end
	if ui and type(ui.get_sec_desc) == "function" then
		orig_sec_desc = ui.get_sec_desc
		ui.get_sec_desc = psy_relief_sec_desc
	end
end

--------------------------------------------------------------------------------
-- Callbacks
--------------------------------------------------------------------------------
local function check_alcohol_api(actor)
	local a = actor:cast_Actor()
	local cond = a and a:conditions()
	return (cond and cond.GetAlcohol) and true or false
end

local function actor_on_first_update()
	apply_options()
	psy_mod = find_psy_module()
	local actor = db.actor
	has_alcohol_api = actor and check_alcohol_api(actor) or false
	if enabled and actor and (#doses > 0 or (drunk_effects_on() and get_drunk(actor) > 0)) then
		start_ticking()
	end
	log("loaded: psy health via %s, drunk effects %s, %d doses carried over from the save",
		psy_mod and "arszi_psy" or "engine (no arszi_psy found)",
		has_alcohol_api and "on" or "OFF (engine has no GetAlcohol)", #doses)
end

local function actor_on_net_destroy()
	clear_doses()
end

local function save_state(m_data)
	local list = {}
	for i = 1, #doses do
		local d = doses[i]
		list[i] = { a = d.left, t = d.ms }
	end
	m_data.psy_relief = { v = DATA_VERSION, doses = list }
end

local function load_state(m_data)
	clear_doses()
	local d = m_data.psy_relief
	local list = type(d) == "table" and type(d.doses) == "table" and d.doses or nil
	if not list then return end
	for i = 1, min(#list, MAX_DOSES) do
		local e = list[i]
		local a = type(e) == "table" and tonumber(e.a)
		local t = type(e) == "table" and tonumber(e.t)
		if a and t and a > 0 and t > 0 then
			doses[#doses + 1] = { left = min(a, 1), ms = t }
		end
	end
end

function on_option_change()
	apply_options()
	if not enabled then
		clear_doses()
		return
	end
	local actor = db.actor
	if actor and drunk_effects_on() and get_drunk(actor) > 0 then
		start_ticking()
	end
end

function on_game_start()
	apply_options()
	load_items()
	install_patches()
	RegisterScriptCallback("actor_on_item_use", actor_on_item_use)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("on_option_change", on_option_change)
end
